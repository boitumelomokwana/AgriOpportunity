# Copy this file to .env for your testing environment, then restart Expo.
#
# Android emulator (10.0.2.2 points at the host machine):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
#
# Android physical device on the same Wi-Fi/LAN (use your computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api
#
# iOS simulator or Expo web on this computer:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
#
# Never put backend secrets such as JWT_SECRET in EXPO_PUBLIC_* variables.
# Everything prefixed with EXPO_PUBLIC_ is embedded in the client bundle.
