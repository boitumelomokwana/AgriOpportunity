# ---------------------------------------------------------------------------
# AgriOpportunities frontend environment
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Never commit real keys to source control.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Public anon/publishable key. This is safe to ship in the app; RLS protects data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the company API backend.
# - Android emulator: http://10.0.2.2:3000/api
# - iOS simulator / web: http://localhost:3000/api
# - Physical device: http://<your-computer-LAN-IP>:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
