# ---------------------------------------------------------------------------
# AgriOpportunities company API backend
# Copy this file to .env and fill in the values. Never commit the service-role
# key: it bypasses Row Level Security and must stay on the server only.
# ---------------------------------------------------------------------------

PORT=3000

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Service-role key from Project Settings -> API. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed browser origins, or * for development.
CORS_ORIGINS=*
